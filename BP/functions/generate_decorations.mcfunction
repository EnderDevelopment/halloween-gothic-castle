setblock ~20 ~1 ~20 minecraft:twisting_vines_plant
setblock ~20 ~ ~-20 minecraft:twisting_vines
setblock ~20 ~1 ~-20 minecraft:twisting_vines_plant
setblock ~-20 ~ ~20 minecraft:twisting_vines
setblock ~-20 ~1 ~20 minecraft:twisting_vines_plant
setblock ~-20 ~ ~-20 minecraft:twisting_vines
setblock ~-20 ~1 ~-20 minecraft:twisting_vines_plant

# Soul lanterns
